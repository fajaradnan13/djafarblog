import { h } from 'preact';

const DEFAULT_REPO = 'fajaradnan13/djafarblog';

interface Props {
  repo?: string;
}

export default function Comments({ repo = DEFAULT_REPO }: Props) {
  return (
    <div id="comments" class="mt-12 pt-8 border-t border-gray-200 dark:border-terminal-border">
      <h3 class="text-lg font-semibold mb-4">Komentar</h3>
      <div id="utterances-container"></div>
      <script dangerouslySetInnerHTML={{ __html: `
        (function() {
          const repo = '${repo}';
          const theme = document.documentElement.classList.contains('dark') ? 'github-dark' : 'github-light';
          const script = document.createElement('script');
          script.src = 'https://utteranc.es/client.js';
          script.setAttribute('repo', repo);
          script.setAttribute('issue-term', 'pathname');
          script.setAttribute('theme', theme);
          script.crossOrigin = 'anonymous';
          script.async = true;
          const container = document.getElementById('utterances-container');
          if (container) container.appendChild(script);
        })();
      ` }} />
    </div>
  );
}
