---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

let posts = [];
try {
    const allPosts = await getCollection('blog', ({ data }) => {
        return import.meta.env.PROD ? data.draft !== true : true;
    });
    posts = allPosts.sort((a, b) => {
        const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
        const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
        return dateB - dateA;
    });
} catch (error) {
    console.error("Failed to load blog collection:", error);
}

const recentPosts = posts.slice(0, 7);
const featuredPost = recentPosts[0];
const otherPosts = recentPosts.slice(1);
---

<Layout
    title="Belajar Teknologi untuk Pemula"
    description="Tutorial, panduan, dan artikel seputar teknologi, programming, dan keamanan siber yang disajikan khusus untuk pemula."
    type="website"
    currentPage="home"
>
    <!-- Hero Section -->
    <section class="relative py-20 lg:py-32 flex items-center justify-center overflow-hidden">
        <!-- Background Effects -->
        <div class="absolute inset-0 bg-gradient-to-b from-primary-500/5 via-transparent to-transparent"></div>
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-500/10 rounded-full blur-3xl animate-float-slow"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl animate-float-slow" style="animation-delay: -4s"></div>
        
        <!-- Grid Pattern -->
        <div class="absolute inset-0 bg-[linear-gradient(rgba(14,165,233,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(14,165,233,0.03)_1px,transparent_1px)] bg-[size:64px_64px] animate-scroll-grid"></div>
        
        <div class="relative z-10 w-full max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Article Slider -->
            <div class="relative w-full mx-auto mb-16 group" id="hero-slider">
                <!-- Slides Container -->
                <div class="overflow-hidden rounded-3xl bg-dark-900 shadow-2xl relative border border-terminal-border">
                    <div class="flex transition-transform duration-700 ease-out h-[500px] md:h-[600px]" id="slider-track">
                        {posts.slice(0, 5).map((post, index) => {
                            const gradients = [
                                'from-primary-900/40 to-dark-900',
                                'from-purple-900/40 to-dark-900',
                                'from-emerald-900/40 to-dark-900',
                                'from-rose-900/40 to-dark-900',
                                'from-cyan-900/40 to-dark-900'
                            ];
                            const bgGradient = gradients[index % gradients.length];
                            
                            return (
                                <div class={`w-full h-full flex-shrink-0 relative flex items-center bg-gradient-to-br ${bgGradient}`}>
                                    <a href={`/blog/${post.slug}/`} class="block w-full p-8 md:p-16 lg:p-24 text-left z-10">
                                        <div class="flex items-center gap-3 mb-6 animate-slide-up">
                                            <span class="tag bg-primary-500 text-white border-none uppercase tracking-wider text-xs px-4 py-1.5">{post.data.category || 'Article'}</span>
                                            <span class="text-sm text-gray-300 font-mono bg-dark-800/50 px-3 py-1 rounded-full backdrop-blur-sm border border-terminal-border">
                                                {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                                                    month: 'long',
                                                    day: 'numeric',
                                                    year: 'numeric'
                                                })}
                                            </span>
                                        </div>
                                        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 hover:text-primary-400 transition-colors line-clamp-2 max-w-4xl animate-slide-up" style="animation-delay: 0.1s">
                                            {post.data.title}
                                        </h2>
                                        <p class="text-lg md:text-xl text-gray-300 leading-relaxed mb-10 line-clamp-2 max-w-3xl animate-slide-up" style="animation-delay: 0.2s">
                                            {post.data.description}
                                        </p>
                                        <div class="inline-flex items-center px-6 py-3 bg-primary-600 hover:bg-primary-500 text-white rounded-lg font-semibold transition-all animate-slide-up" style="animation-delay: 0.3s">
                                            Baca Artikel
                                            <svg class="w-5 h-5 ml-2 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                            </svg>
                                        </div>
                                    </a>
                                </div>
                            );
                        })}
                    </div>
                    
                    <!-- Navigation Controls (Inside slider) -->
                    <div class="absolute inset-y-0 left-0 flex items-center pl-4 md:pl-8 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20">
                        <button id="slider-prev" class="w-12 h-12 rounded-full bg-dark-900/60 backdrop-blur-md border border-terminal-border text-white hover:bg-primary-500/80 hover:border-primary-400 flex items-center justify-center transition-all shadow-lg focus:outline-none" aria-label="Previous slide">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                        </button>
                    </div>
                    <div class="absolute inset-y-0 right-0 flex items-center pr-4 md:pr-8 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20">
                        <button id="slider-next" class="w-12 h-12 rounded-full bg-dark-900/60 backdrop-blur-md border border-terminal-border text-white hover:bg-primary-500/80 hover:border-primary-400 flex items-center justify-center transition-all shadow-lg focus:outline-none" aria-label="Next slide">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        </button>
                    </div>

                    <!-- Pagination Dots -->
                    <div class="absolute bottom-6 left-0 right-0 flex justify-center gap-3 z-20" id="slider-dots">
                        {posts.slice(0, 5).map((_, i) => (
                            <button class="w-3 h-3 rounded-full bg-white/30 hover:bg-white transition-all focus:outline-none backdrop-blur-sm" data-index={i} aria-label={`Go to slide ${i + 1}`}></button>
                        ))}
                    </div>
                </div>
            </div>
            
            <!-- Stats -->
            <div class="grid grid-cols-3 gap-8 mt-12 pt-10 border-t border-gray-200 dark:border-terminal-border animate-fade-in text-center" style="animation-delay: 0.3s">
                <div>
                    <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-1">{posts.length}+</div>
                    <div class="text-sm text-gray-500 dark:text-gray-500">Artikel & Panduan</div>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-1">5+</div>
                    <div class="text-sm text-gray-500 dark:text-gray-500">Kategori Topik</div>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-1">100%</div>
                    <div class="text-sm text-gray-500 dark:text-gray-500">Fokus Teknologi</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Articles -->
    <section class="py-24 relative">
        <!-- Subtle background glow for the section -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-full bg-primary-500/5 blur-[120px] pointer-events-none"></div>
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-16 gap-6">
                <div>
                    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Artikel <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-cyan-400">Terbaru</span></h2>
                    <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl">Eksplorasi wawasan, tutorial teknis, dan catatan belajar terbaru yang dikurasi khusus untuk Anda.</p>
                </div>
                <a href="/blog" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-dark-800 border border-terminal-border text-primary-400 hover:text-primary-300 hover:bg-dark-700 hover:border-primary-500/50 transition-all group font-medium whitespace-nowrap">
                    Lihat semua
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                {(() => {
                    const getGradient = (cat) => {
                        const gradients = {
                            'security': 'from-red-500/80 to-purple-600/80',
                            'programming': 'from-blue-500/80 to-cyan-600/80',
                            'devops': 'from-green-500/80 to-emerald-600/80',
                            'open source': 'from-purple-500/80 to-pink-600/80',
                            'tutorials': 'from-yellow-500/80 to-orange-600/80'
                        };
                        return gradients[cat?.toLowerCase()] || 'from-primary-500/80 to-blue-600/80';
                    };

                    return (
                        <>
                            {/* Featured Article (Large Bento Box) */}
                            {featuredPost && (
                                <article class="group relative overflow-hidden rounded-[2rem] bg-white/40 dark:bg-dark-800/40 backdrop-blur-xl border border-gray-200 dark:border-white/10 hover:border-primary-500/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)] hover:shadow-primary-500/20 md:col-span-2 lg:col-span-2 flex flex-col justify-end min-h-[400px]">
                                    <!-- Full background cover for featured -->
                                    <div class={`absolute inset-0 bg-gradient-to-br ${getGradient(featuredPost.data.category)} opacity-40 group-hover:opacity-50 transition-opacity duration-500`}>
                                        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-30 mix-blend-overlay"></div>
                                    </div>
                                    <!-- Dark gradient overlay for text readability -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-white via-white/80 dark:from-dark-900 dark:via-dark-900/80 to-transparent"></div>
                                    
                                    <a href={`/blog/${featuredPost.slug}/`} class="relative z-10 block p-8 sm:p-12">
                                        <div class="flex items-center gap-4 mb-6">
                                            <span class="px-4 py-1.5 rounded-full bg-black/5 dark:bg-white/10 backdrop-blur-md text-gray-900 dark:text-white text-xs font-bold uppercase tracking-wider border border-black/10 dark:border-white/20 shadow-xl">
                                                {featuredPost.data.category || 'Article'}
                                            </span>
                                            <div class="flex items-center text-gray-300 text-sm font-mono">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                                {new Date(featuredPost.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                                            </div>
                                        </div>
                                        <h3 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4 group-hover:text-primary-600 dark:group-hover:text-primary-300 transition-colors leading-tight">
                                            {featuredPost.data.title}
                                        </h3>
                                        <p class="text-gray-700 dark:text-gray-300 text-lg leading-relaxed mb-8 line-clamp-2 max-w-2xl">
                                            {featuredPost.data.description}
                                        </p>
                                        <div class="inline-flex items-center text-primary-600 dark:text-primary-400 font-semibold group-hover:text-primary-500 dark:group-hover:text-primary-300 transition-colors">
                                            Baca Selengkapnya
                                            <svg class="w-5 h-5 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                            </svg>
                                        </div>
                                    </a>
                                </article>
                            )}

                            <!-- Other Recent Articles (Standard Bento Boxes) -->
                            {otherPosts.slice(0, 4).map((post) => (
                                <article class="group relative overflow-hidden rounded-[2rem] bg-white/40 dark:bg-dark-800/40 backdrop-blur-xl border border-gray-200 dark:border-white/10 hover:border-primary-500/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)] hover:shadow-primary-500/20 flex flex-col">
                                    <!-- Top visual cover -->
                                    <div class={`h-48 w-full bg-gradient-to-br ${getGradient(post.data.category)} relative overflow-hidden`}>
                                        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-30 mix-blend-overlay"></div>
                                        <div class="absolute inset-0 bg-dark-900/20 group-hover:bg-transparent transition-colors duration-500"></div>
                                    </div>
                                    
                                    <a href={`/blog/${post.slug}/`} class="flex flex-col flex-grow p-6 sm:p-8 relative z-10 bg-gradient-to-b from-white/50 to-white/80 dark:from-dark-800/50 dark:to-dark-900/80">
                                        <div class="flex items-center justify-between mb-6">
                                            <span class="px-3 py-1 rounded-full bg-primary-500/20 text-primary-400 text-xs font-bold uppercase tracking-wider border border-primary-500/30">
                                                {post.data.category || 'Article'}
                                            </span>
                                            <div class="flex items-center text-gray-400 text-xs font-mono">
                                                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                                            </div>
                                        </div>
                                        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2 leading-snug">
                                            {post.data.title}
                                        </h3>
                                        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-6 line-clamp-3 flex-grow">
                                            {post.data.description}
                                        </p>
                                        <div class="inline-flex items-center text-primary-500 text-sm font-semibold group-hover:text-primary-400 transition-colors mt-auto">
                                            Baca
                                            <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                            </svg>
                                        </div>
                                    </a>
                                </article>
                            ))}
                        </>
                    );
                })()}
            </div>
        </div>
    </section>

    <!-- Topics Section -->
    <section class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">Topik Pembahasan</h2>
                <p class="text-gray-600 dark:text-gray-400">Eksplorasi mendalam ke berbagai area teknologi dan keamanan siber</p>
            </div>
            
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Security -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-lg bg-red-500/10 dark:bg-red-500/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Security</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Vulnerability research, penetration testing, and security best practices.</p>
                </div>
                
                <!-- Programming -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-lg bg-blue-500/10 dark:bg-blue-500/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Programming</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Tutorials and insights on modern programming languages and frameworks.</p>
                </div>
                
                <!-- DevOps -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-lg bg-green-500/10 dark:bg-green-500/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">DevOps</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">CI/CD, containerization, infrastructure as code, and cloud technologies.</p>
                </div>
                
                <!-- Open Source -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-lg bg-purple-500/10 dark:bg-purple-500/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Open Source</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Contributing to and maintaining open-source projects.</p>
                </div>
                
                <!-- Tutorials -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-lg bg-yellow-500/10 dark:bg-yellow-500/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Tutorials</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Step-by-step guides and how-tos for various technologies.</p>
                </div>
                
                <!-- Technology -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-lg bg-cyan-500/10 dark:bg-cyan-500/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Technology</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Analysis and thoughts on emerging technologies and trends.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="py-20 border-t border-white/5 relative">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">Berlangganan Newsletter</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-8">
                Dapatkan pemberitahuan saat artikel terbaru diterbitkan. Tanpa spam.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
                <input
                    type="email"
                    placeholder="Masukkan email Anda"
                    class="flex-1 px-4 py-3 bg-white dark:bg-dark-700 border border-gray-300 dark:border-terminal-border rounded-lg text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500"
                />
                <button class="btn-primary whitespace-nowrap">
                    Berlangganan
                </button>
            </div>
        </div>
    </section>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const track = document.getElementById('slider-track');
        const slides = track ? track.children : [];
        const dots = document.querySelectorAll('#slider-dots button');
        const prevBtn = document.getElementById('slider-prev');
        const nextBtn = document.getElementById('slider-next');
        
        if (track && slides.length > 0) {
            let currentIndex = 0;
            const totalSlides = slides.length;
            let interval;

            function updateSlider() {
                track.style.transform = `translateX(-${currentIndex * 100}%)`;
                dots.forEach((dot, index) => {
                    if (index === currentIndex) {
                        dot.classList.add('bg-white', 'w-8');
                        dot.classList.remove('bg-white/30', 'w-3');
                    } else {
                        dot.classList.remove('bg-white', 'w-8');
                        dot.classList.add('bg-white/30', 'w-3');
                    }
                });
            }

            function nextSlide() {
                currentIndex = (currentIndex + 1) % totalSlides;
                updateSlider();
            }

            function prevSlide() {
                currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
                updateSlider();
            }

            function resetInterval() {
                clearInterval(interval);
                interval = setInterval(nextSlide, 5000);
            }

            nextBtn?.addEventListener('click', () => {
                nextSlide();
                resetInterval();
            });

            prevBtn?.addEventListener('click', () => {
                prevSlide();
                resetInterval();
            });

            dots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    currentIndex = index;
                    updateSlider();
                    resetInterval();
                });
            });

            // Initialize
            updateSlider();
            resetInterval();

            // Pause on hover
            const slider = document.getElementById('hero-slider');
            slider?.addEventListener('mouseenter', () => clearInterval(interval));
            slider?.addEventListener('mouseleave', () => resetInterval());
        }
    });
</script>
